{
  "name": "app_convert",
  "version": "1.0.0",
  "description": "TXT to Excel converter for Revit quantity exports",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "desktop": "npm run build && electron .",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "dist": "npm run build && node scripts/build-exe.cjs",
    "dist:nologin": "node scripts/build-exe.cjs --no-login"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "build": {
    "appId": "com.blb.bimlabconvert",
    "productName": "BIMLab Convert TXT To Excel",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "icon": "IgBl.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "BIMLab_Convert_TXT_To_Excel.exe"
    }
  },
  "type": "commonjs",
  "dependencies": {
    "lucide-react": "^1.11.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "vite": "^8.0.10"
  }
}
